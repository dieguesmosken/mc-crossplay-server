# Copie para .env (ignorado pelo Git) para sobrescrever os padrões. Não coloque segredos aqui.

# Limite de memória do container.
MC_MEMORY_LIMIT=3g

# Heap da JVM (-Xms/-Xmx). Deve ficar abaixo de MC_MEMORY_LIMIT: o container ainda precisa
# de espaço para metaspace, threads e memória off-heap (regra prática: heap ≈ 2/3 do limite).
MC_JAVA_HEAP=2G

# Flags extras da JVM, separadas por espaço (opcional).
MC_JAVA_OPTS=

# Endereço do host em que as portas 25565/tcp, 19132/udp e 19132/tcp são publicadas.
#   127.0.0.1  (padrão, seguro) só este computador alcança o servidor.
#   IP da LAN  (ex.: 192.168.0.20) só a interface de rede desse IP.
#   0.0.0.0    todas as interfaces: qualquer aparelho da sua rede alcança o servidor.
# ATENÇÃO: o Docker ignora as regras do ufw. Com qualquer valor diferente de 127.0.0.1 o
# servidor fica aberto para a LAN (inclusive sem whitelist). Use só em rede de confiança e
# volte para 127.0.0.1 quando terminar o teste. Nunca encaminhe estas portas no roteador.
MC_BIND_ADDRESS=127.0.0.1

# Segredo HMAC compartilhado entre a API da fila (perfil "api") e o plugin McPlatform.
# Mínimo de 16 caracteres, aleatório. Para gerar:  openssl rand -hex 32
# Deixe VAZIO aqui: este arquivo vai para o Git. Coloque o valor real só no seu .env.
# Sem ele a API recusa subir (e o plugin, se instalado, fica com a configuração inválida).
MC_API_SECRET=

# Painel admin e site (servidos pela API em http://127.0.0.1:8787 neste computador).
# Hash da senha do admin. Gere com:  pnpm --filter @mc-platform/api hash-password
# (a senha é digitada sem eco e nunca é gravada; só o hash é impresso). Mínimo de 12 caracteres.
# Deixe VAZIO aqui (este arquivo vai para o Git). Vazio = painel desligado.
MC_ADMIN_PASSWORD_HASH=
# Porta local do painel (só em 127.0.0.1).
MC_ADMIN_PORT=8787
# Ponha 1 quando o painel estiver atrás de HTTPS (cookie com atributo Secure).
MC_ADMIN_SECURE_COOKIE=0

# Segredo compartilhado com o Worker de borda (apps/edge-gateway), mínimo de 32 caracteres.
# Para gerar:  openssl rand -hex 32   (o MESMO valor vai em EDGE_SECRET no Worker).
# Deixe VAZIO aqui (este arquivo vai para o Git). Vazio = o painel só aceita o login local.
MC_EDGE_SECRET=
# 1 quando o Tunnel estiver publicado: a API passa a atender só pedidos assinados pelo Worker
# (mais /health e as rotas do plugin). Exige MC_EDGE_SECRET. O painel local (127.0.0.1) deixa de abrir.
# Sem isto, quem descobrir o hostname do Tunnel alcança as rotas públicas da fila.
MC_EDGE_ONLY=0
