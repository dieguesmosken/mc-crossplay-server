# Copie para .env (ignorado pelo Git) para sobrescrever os padrões. Não coloque segredos aqui.

# Limite de memória do container.
MC_MEMORY_LIMIT=3g

# Heap da JVM (-Xms/-Xmx). Deve ficar abaixo de MC_MEMORY_LIMIT: o container ainda precisa
# de espaço para metaspace, threads e memória off-heap (regra prática: heap ≈ 2/3 do limite).
MC_JAVA_HEAP=2G

# Flags extras da JVM, separadas por espaço (opcional).
MC_JAVA_OPTS=

# Endereço do host em que as portas 25565/tcp, 19132/udp e 19132/tcp são publicadas.
#   127.0.0.1  (padrão, seguro) só este computador alcança o servidor.
#   IP da LAN  (ex.: 192.168.0.20) só a interface de rede desse IP.
#   0.0.0.0    todas as interfaces: qualquer aparelho da sua rede alcança o servidor.
# ATENÇÃO: o Docker ignora as regras do ufw. Com qualquer valor diferente de 127.0.0.1 o
# servidor fica aberto para a LAN (inclusive sem whitelist). Use só em rede de confiança e
# volte para 127.0.0.1 quando terminar o teste. Nunca encaminhe estas portas no roteador.
MC_BIND_ADDRESS=127.0.0.1
